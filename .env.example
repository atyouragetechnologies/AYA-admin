# ==============================================================================
# AYA — At Your Age | Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ==============================================================================

# 1. SUPABASE (REQUIRED)
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI...your_anon_key
# Server-side only — DO NOT use on frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI...your_service_role_key
# Security salt for phone authentication
VITE_AUTH_SALT=your_secure_random_salt_here

# 2. FIREBASE (REQUIRED — Google OAuth + Crashlytics)
# Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# 3. BACKBLAZE B2 STORAGE (for server-side asset scripts)
# The bucket is PRIVATE — in-app access always via Cloudflare CDN proxy.
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=aya-game-assets-cloud
B2_BUCKET_ID=your_b2_bucket_id

# 4. CLOUDFLARE (for Cloudflare Pages deploy + B2 CDN worker)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# 5. GITHUB (for OTA trigger scripts)
GITHUB_PAT=ghp_your_personal_access_token

# 6. ANDROID KEYSTORE (for signing production APK/AAB)
# Also set these in android/gradle.properties
MYAPP_RELEASE_STORE_FILE=release-key.jks
MYAPP_RELEASE_KEY_ALIAS=your-key-alias
MYAPP_RELEASE_STORE_PASSWORD=your_store_password
MYAPP_RELEASE_KEY_PASSWORD=your_key_password

# 7. OPTIONAL SERVICES

# Groq AI — personality analysis (if enabled)
# GROQ_API_KEY=gsk_...
# VITE_GROQ_API_KEY=gsk_...

# Cashfree Payments — deferred, not active in current build
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENVIRONMENT=SANDBOX

# Web Push VAPID — if enabling web push notifications
# VAPID_PUBLIC_KEY=
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@atyourage.app
