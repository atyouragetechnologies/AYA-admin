# AYA Android Release Signing — keystore.properties
#
# HOW TO USE:
# 1. Generate a keystore: keytool -genkey -v -keystore aya-release.jks -alias aya -keyalg RSA -keysize 2048 -validity 10000
# 2. Move aya-release.jks to: android/app/aya-release.jks
# 3. Fill in the values below
#
#
# storeFile=app/aya-release.jks
# storePassword=YOUR_STORE_PASSWORD
# keyAlias=aya
# keyPassword=YOUR_KEY_PASSWORD
