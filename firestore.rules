rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ota_config: publicly readable by Android app to check for OTA updates
    // Only writable via ota-push.mjs server script (REST API)
    match /ota_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}